@page
@model IndexModel
@{
    ViewData["Title"] = "PinSharp Batch";
}

<section class="hero">
    <div>
        <p class="eyebrow">Linux-ready batch pin production</p>
        <h1>PinSharp Web Studio</h1>
        <p class="hero-copy">Select an image folder, upload one <code>title|code</code> file, render in parallel, and download the finished batch as a zip.</p>
    </div>
    <div class="hero-card">
        <div class="metric"><strong>@Environment.ProcessorCount</strong><span>CPU threads available</span></div>
        <div class="metric"><strong>@Model.Sizes.Count</strong><span>canvas presets</span></div>
        <div class="metric"><strong>8</strong><span>rotating layouts</span></div>
    </div>
</section>

<section class="studio-grid">
    <form method="post" enctype="multipart/form-data" class="control-panel">
        <div class="panel-head">
            <h2>Batch Setup</h2>
            <p>Best for Linux RDP, VPS hosting, and remote browser control.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert error">@Model.ErrorMessage</div>
        }

        <label class="field">
            <span>Image folder</span>
            <input asp-for="Images" type="file" accept=".jpg,.jpeg,.png,.bmp,.webp" webkitdirectory="" directory="" multiple />
            <small>Select one folder. Supported images are paired in filename order.</small>
        </label>

        <label class="field">
            <span>input.txt</span>
            <input asp-for="InputFile" type="file" accept=".txt" />
            <small>One line per item: <code>Title goes here|CODE123</code></small>
        </label>

        <div class="row-grid">
            <label class="field">
                <span>Canvas</span>
                <select asp-for="SizeId">
                    @foreach (var size in Model.Sizes)
                    {
                        <option value="@size.Id">@size</option>
                    }
                </select>
            </label>

            <label class="field">
                <span>Format</span>
                <select asp-for="Format">
                    <option value="png">PNG</option>
                    <option value="jpg">JPG</option>
                </select>
            </label>
        </div>

        <div class="row-grid">
            <label class="field">
                <span>JPG quality</span>
                <input asp-for="JpegQuality" type="number" min="1" max="100" />
            </label>

            <label class="field">
                <span>Threads</span>
                <select asp-for="ThreadCount">
                    @foreach (var thread in Model.ThreadOptions)
                    {
                        <option value="@thread">@thread</option>
                    }
                </select>
            </label>
        </div>

        <button type="submit" class="primary-action">Run batch render</button>
    </form>

    <aside class="notes-panel">
        <h2>What changed</h2>
        <ul>
            <li>The batch tool now runs in a browser, which fits Linux RDP much better than WPF.</li>
            <li>Rendering uses a cross-platform image pipeline, so the same batch flow can move to Linux hosting.</li>
            <li>Parallel rendering is controlled directly from the page.</li>
        </ul>
    </aside>
</section>

@if (Model.Summary is not null)
{
    <section class="results">
        <div class="results-head">
            <div>
                <p class="eyebrow">Batch complete</p>
                <h2>@Model.Summary.RenderedCount pins rendered</h2>
                <p>@Model.Summary.InputRows input rows, @Model.Summary.QueuedImages uploaded images, @Model.Summary.ThreadCount threads used.</p>
            </div>
            <a class="download-link" href="~/runs/@Model.Summary.JobId/@Model.Summary.ZipRelativePath">Download zip</a>
        </div>

        <div class="result-grid">
            @foreach (var item in Model.Summary.Outputs)
            {
                <article class="result-card">
                    <img src="~/runs/@Model.Summary.JobId/output/@item.RelativePath" alt="@item.Title" loading="lazy" />
                    <div class="result-meta">
                        <strong>@item.Code</strong>
                        <span>@item.Layout</span>
                        <p>@item.Title</p>
                    </div>
                </article>
            }
        </div>
    </section>
}
